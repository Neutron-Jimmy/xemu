<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="@IDN@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>@DISP@</DisplayName>
    <PublisherDisplayName>xemu UWP</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17134.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <Resources><Resource Language="en-us"/></Resources>
  <Applications>
    <Application Id="App" Executable="@EXE@" EntryPoint="Xemu.App">
      <uap:VisualElements DisplayName="@DISP@" Description="@DISP@" BackgroundColor="#000000"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000"/>
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <!-- codeGeneration: execute views for the JIT. removableStorage + broadFileSystemAccess: files outside the
         app's own folders (USB drives, the console's storage), opened through the ...FromApp calls -->
    <Capability Name="codeGeneration"/>
    <Capability Name="privateNetworkClientServer"/>
    <Capability Name="internetClientServer"/>
    <uap:Capability Name="removableStorage"/>
    <rescap:Capability Name="broadFileSystemAccess"/>
  </Capabilities>
</Package>
